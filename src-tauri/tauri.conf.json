{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaolin-Assets",
  "version": "0.1.0",
  "identifier": "com.kaolin-assets.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kaolin-Assets · 高岭土机理图绘制软件",
        "width": 1440,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "Kaolin-Assets 场景文件",
        "ext": ["kaolin-scene.json"],
        "role": "Editor"
      }
    ],
    "category": "GraphicsDesign"
  }
}
